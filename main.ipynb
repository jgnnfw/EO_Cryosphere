   "source": [
    "# Group Project Cryosphere\n",
    "\n",
    "Earth Observation group project about a glacier in the Himalaya in Nepal. We try to measure glacier area, surface temperature variation, and wet/total snow area using satellite data from Google Earth Engine. We investigate these aspects on the time series of 2015 - 2026.\n",
    "\n",
    "## Initializing"
   ]
  },
  {
   "cell_type": "code",
   "id": "caa973f8cb634ee9",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-19T12:34:28.667465100Z",
     "start_time": "2026-11-19T12:34:24.324418400Z"
    }
   },
   "source": [
    "import ee\n",
    "import os\n",
    "import geemap\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import plotting as pl\n",
    "import glacier_area as ga\n",
    "import gst_line as gl\n",
    "import sar_snow as ss\n",
    "import io_param_functions as ipf"
   ],
   "outputs": [],
   "execution_count": 1
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
