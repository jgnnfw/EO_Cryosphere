   "cell_type": "markdown",
   "id": "204f96099e42abc2",
   "metadata": {},
   "source": "## Surface temperature variation (gst_line)"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "Map = geemap.Map(basemap=\"HYBRID\")\n",
    "Map.centerObject(AOI, 14)\n",
    "Map.addLayer(ee.Image().paint(AOI, 1, 2), {\"palette\": [\"red\"]}, \"AOI\")\n",
    "Map.addLayer(ee.Image().paint(glacier_glims_geom, 1, 2), {\"palette\": [\"blue\"]}, \"Glims outline\")\n",
    "Map"
   ],
   "id": "113129701e091019",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "aoi_coords = [\n",
    "    [81.756821, 30.184416],\n",
    "    [81.791840, 30.184416],\n",
    "    [81.791840, 30.255022],\n",
    "    [81.756821, 30.255022],\n",
    "    [81.756821, 30.184416]\n",
    "]\n",
    "BBOX = ee.Geometry.Polygon(aoi_coords)"
   ],
   "id": "66e7b6b5a134d8b2",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "lst = gl.download_lst(BBOX, START, END, max_cloud=60, debug=DEBUG)\n",
    "stack = gl.season_stack(lst, BBOX)\n",
    "n_season = gl.season_count(lst, debug=DEBUG)"
   ],
   "id": "8ec4f70a82edff11",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "# to use a hand-drawn line: draw it on a Map = geemap.Map, then pass user_roi=Map.user_roi\n",
    "line = gl.get_centerline([[81.774, 30.225], [81.776, 30.220], [81.775, 30.195]][::-1], user_roi=None, debug=DEBUG)\n",
    "map_lst = pl.map_gst_line_map(stack, BBOX, glacier_glims_geom, line)\n",
    "map_lst"
   ],
   "id": "72a934aba80b27c7",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "profile_df = gl.temp_profile(stack, line, step_m=150, debug=DEBUG)\n",
    "fig_profile = pl.plot_gst_line_profile(profile_df, n_season, glacier_beginning_m=600, glacier_end_m=2600)"
   ],
   "id": "887ea3c5eeaf0721",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "arrays = gl.season_arrays(stack, BBOX)\n",
    "fig_gl_spatial = pl.plot_gst_line_seasons(arrays, gl.roi_extent(BBOX), n_season, AOI, glims=glacier_glims_geom)"
   ],
   "id": "8f377fb149858784",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "scene_df = gl.scene_temp_table(lst, ipf.study_region(AOI, glacier_glims_geom), debug=DEBUG)\n",
    "fit_df, curve_df, stats = gl.fit_temp_trend(scene_df)\n",
    "fig_ts = pl.plot_gst_line_timeseries(fit_df, curve_df, stats)"
   ],
   "id": "1ca60c3aef67a285",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "ipf.save_any_tables_and_figures(\n",
    "    {\"lst_profile\": profile_df,\n",
    "     \"lst_scenes\": scene_df,\n",
    "     \"lst_profile_fig\": fig_profile,\n",
    "     \"lst_spatial_fig\": fig_spatial,\n",
    "     \"lst_timeseries_fig\": fig_ts},\n",
    "    save_path=\"results/gst_line\",\n",
    "    debug=DEBUG\n",
    ")"
   ],
   "id": "d8517e9d09c164d3",
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "id": "8dce1e4da7f1c79c",
   "metadata": {},
   "source": "## Wet snow area"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": "glacier_mask, mask_status = ipf.get_glacier_mask(AOI, debug=True)",
   "id": "a585944b1be10cf1",
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "id": "403b6a0544781fe8",
   "metadata": {},
   "source": [
    "REF = (12, 1, 2)\n",
    "WET = (3, 4, 5)"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "id": "ab298cd123656c45",
   "metadata": {},
   "source": [
    "SY = 2024\n",
    "ORBIT = \"ASCENDING\"\n",
    "MONTHS = (12, *range(1, 7))\n",
    "\n",
    "DAY_TICKS_ALL = ([32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335, 0],\n",
    "                 [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"])\n",
    "\n",
    "day_ticks = ([DAY_TICKS_ALL[0][m - 1] for m in MONTHS],\n",
    "             [DAY_TICKS_ALL[1][m - 1] for m in MONTHS])\n",
    "print(day_ticks)"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": "df, bdf = ss.all_stats(AOI, \"2015-12-01\", \"2025-06-01\", glacier_mask=glacier_mask, ref_months=REF, wet_months=WET)",
   "id": "fcb76b3ffbef785c",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "monthly_table = ss.monthly_mean_table(df)\n",
    "\n",
    "fig_snow_series = ss.plot_sar_snow_series(df)\n",
    "fig_snow_season = ss.plot_sar_snow_season(df, day_ticks=day_ticks)"
   ],
   "id": "4b2dce2abed9ea38",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "ipf.save_any_tables_and_figures(\n",
    "    {\"snow_scenes\": df,\n",
    "     \"snow_elev_bands\": bdf,\n",
    "     \"monthly_table\": monthly_table,\n",
    "     \"sar_snow_series\": fig_snow_series,\n",
    "     \"sar_snow_season\": fig_snow_season},\n",
    "    save_path=\"results/sar_snow/\",\n",
    ")"
   ],
   "id": "35cb372e066b1332",
   "outputs": [],
   "execution_count": null
  },
