   ],
   "id": "b492f4dc95dac999"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "# run once at beginning, supply token\n",
    "ee.Authenticate()\n",
    "GEE_PROJECT = \"my-hello-world-508910\"  # replace with your own project id\n",
    "ee.Initialize(project=GEE_PROJECT)"
   ],
   "id": "b61d3723fa3177c1"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "ROI = [[81.768322, 30.198924], [81.785316, 30.200185], [81.782656, 30.20241], [81.780596, 30.2079], [81.780252, 30.215613], [81.780424, 30.223327], [81.778965, 30.228741], [81.776733, 30.231707], [81.774759, 30.231781], [81.771927, 30.225403], [81.77021, 30.216503], [81.770382, 30.211237], [81.770296, 30.206416], [81.766691, 30.202707], [81.765575, 30.199962], [81.768322, 30.198924]]\n",
    "AOI = ee.Geometry.Polygon(ROI)"
   ],
   "id": "d229d9d523516375"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "START = \"2014-09-01\"\n",
    "END = \"2026-12-31\"\n",
    "YEARS = list(range(2015, 2027))\n",
    "\n",
    "DEBUG = True\n",
    "SAVE_PATH = \"results\""
   ],
   "id": "62f1fc2bde9b92d3"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "glims = ee.FeatureCollection(\"GLIMS/current\").filterBounds(AOI)  # keep: all years, needed for the area history\n",
    "glims_areas = ga.glims_area_by_year(glims, AOI, debug=True, min_year_inclusive=2000)\n",
    "glacier_glims_geom = ipf.get_latest_glims(AOI, debug=True)\n",
    "glacier_glims_geom"
   ],
   "id": "ee7a8a8af70f36ec"
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": [
    "## Image Collections Analysis\n",
    "\n",
    "Get a sense of how many Images we are working with, from what date they are and how much they are covered by clouds."
   ],
   "id": "2b02416f2f728477"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "s2_toa = ee.ImageCollection(\"COPERNICUS/S2_HARMONIZED\").filterBounds(AOI).sort(\"system:time_start\").set(\"collection_name\", \"Sentinel 2 Top of Atmosphere\")\n",
    "s2_boa = ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\").filterBounds(AOI).sort(\"system:time_start\").set(\"collection_name\", \"Sentinel 2 Bottom of Atmosphere\")"
   ],
   "id": "60985ee28c945fe0"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "fig_s2_toa_obsv = pl.plot_histogram_image_collection(s2_toa, \"2015-09-01\", \"2027-01-01\")\n",
    "fig_s2_boa_obsv = pl.plot_histogram_image_collection(s2_boa, \"2015-09-01\", \"2027-01-01\", fig_size=(10,3))\n",
    "ipf.save_any_tables_and_figures({\"S2_BOA_number_of_observations\": fig_s2_boa_obsv}, save_path=\"results/\")"
   ],
   "id": "b2bf66a872c1d5dc"
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": [
    "## Snow/ice area\n",
    "\n",
    "Sentinel 2 median -> NDSI -> greater than 0.4"
   ],
   "id": "705dbf2096f2f509"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "masks = ga.download_snow_masks(AOI, YEARS, months=(7, 9), debug=False)\n",
    "# map_area = pl.map_glacier_area(masks, AOI, glacier_glims_geom)\n",
    "# map_area"
   ],
   "id": "b851d63c17c6c5bf"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": "season_df = ga.area_by_season(AOI, YEARS, debug=False)  # glacier_mask=glacier_mask restricts to GLIMS",
   "id": "915c7c23f139c515"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": "fig_seasons = pl.plot_glacier_area_seasons(season_df, glims_areas, min_year_inclusive=2015)",
   "id": "aa617898f9396620"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "for area_year in YEARS:\n",
    "    month_df = ga.area_by_month(AOI, area_year, debug=True)\n",
    "    fig_months = pl.plot_glacier_area_months(month_df, area_year)\n",
    "    ipf.save_any_tables_and_figures(\n",
    "        {f\"area_months_{area_year}\": month_df,\n",
    "         f\"area_months_fig_{area_year}\": fig_months},\n",
    "        save_path=\"results/glacier_area/per_month\",\n",
    "        debug=True\n",
    "    )"
   ],
   "id": "85c7506f4d2164ce"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "ipf.save_any_tables_and_figures(\n",
    "    {\"area_seasons\": season_df,\n",
    "     \"area_seasons_fig\": fig_seasons},\n",
    "    save_path=\"results/glacier_area\",\n",
    "    debug=DEBUG\n",
    ")"
   ],
   "id": "d97b476d3b35327b"
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "## Surface temperature variation (gst_line)",
   "id": "ced9dc1d9c33f552"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "Map = geemap.Map(basemap=\"HYBRID\")\n",
    "Map.centerObject(AOI, 14)\n",
    "Map.addLayer(ee.Image().paint(AOI, 1, 2), {\"palette\": [\"red\"]}, \"AOI\")\n",
    "Map.addLayer(ee.Image().paint(glacier_glims_geom, 1, 2), {\"palette\": [\"blue\"]}, \"Glims outline\")\n",
    "Map"
   ],
   "id": "64d5683a476ccf5d"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "aoi_coords = [\n",
    "    [81.756821, 30.184416],\n",
    "    [81.791840, 30.184416],\n",
    "    [81.791840, 30.255022],\n",
    "    [81.756821, 30.255022],\n",
    "    [81.756821, 30.184416]\n",
    "]\n",
    "BBOX = ee.Geometry.Polygon(aoi_coords)"
   ],
   "id": "b5260ce5a724d71e"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "lst = gl.download_lst(BBOX, START, END, max_cloud=60, debug=DEBUG)\n",
    "stack = gl.season_stack(lst, BBOX)\n",
    "n_season = gl.season_count(lst, debug=DEBUG)"
   ],
   "id": "827e4d73dd025424"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "# to use a hand-drawn line: draw it on a Map = geemap.Map, then pass user_roi=Map.user_roi\n",
    "line = gl.get_centerline([[81.774, 30.225], [81.776, 30.220], [81.775, 30.195]][::-1], user_roi=None, debug=DEBUG)\n",
    "map_lst = pl.map_gst_line_map(stack, BBOX, glacier_glims_geom, line)\n",
    "map_lst"
   ],
   "id": "27502f1fb246f289"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "profile_df = gl.temp_profile(stack, line, step_m=150, debug=DEBUG)\n",
    "fig_profile = pl.plot_gst_line_profile(profile_df, n_season, glacier_beginning_m=600, glacier_end_m=2600)"
   ],
   "id": "ba1df0a495ec421a"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "arrays = gl.season_arrays(stack, BBOX)\n",
    "fig_gl_spatial = pl.plot_gst_line_seasons(arrays, gl.roi_extent(BBOX), n_season, AOI, glims=glacier_glims_geom)"
   ],
   "id": "b560a381e2ee9255"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "scene_df = gl.scene_temp_table(lst, ipf.study_region(AOI, glacier_glims_geom), debug=DEBUG)\n",
    "fit_df, curve_df, stats = gl.fit_temp_trend(scene_df)\n",
    "fig_ts = pl.plot_gst_line_timeseries(fit_df, curve_df, stats)"
   ],
   "id": "c3144fabf81150ce"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "ipf.save_any_tables_and_figures(\n",
    "    {\"lst_profile\": profile_df,\n",
    "     \"lst_scenes\": scene_df,\n",
    "     \"lst_profile_fig\": fig_profile,\n",
    "     \"lst_spatial_fig\": fig_gl_spatial,\n",
    "     \"lst_timeseries_fig\": fig_ts},\n",
    "    save_path=\"results/gst_line\",\n",
    "    debug=DEBUG\n",
    ")"
   ],
   "id": "b4731dfc655ee7ae"
  },
  {
   "metadata": {},
